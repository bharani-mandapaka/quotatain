# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST].supabase.co:5432/postgres"

# Redis (Upstash)
REDIS_URL="redis://default:[YOUR-PASSWORD]@[YOUR-HOST].upstash.io:6379"

# Auth
JWT_SECRET="change-this-to-a-long-random-string-in-production"

# Web app URL (for CORS)
WEB_URL="http://localhost:3000"

# Anthropic (Claude API)
ANTHROPIC_API_KEY="sk-ant-..."

# Data Providers — add as you sign up
APOLLO_API_KEY=""              # apollo.io → Settings → API Keys (free plan)
CRUNCHBASE_API_KEY=""          # crunchbase.com → Developers (Basic plan)
BUILTWITH_API_KEY=""           # builtwith.com → API (free trial available)
TOFLER_API_KEY=""              # tofler.in → API Access
NEWSAPI_KEY=""                 # newsapi.org → Get API Key (free tier)

# Google (domain resolution + optional GA4)
GOOGLE_SEARCH_API_KEY=""       # console.cloud.google.com → Custom Search API
GOOGLE_SEARCH_CX=""            # programmablesearchengine.google.com → Engine ID

# Worker settings
WORKER_CONCURRENCY=10
LOG_LEVEL=info
PORT=3001
NODE_ENV=development
