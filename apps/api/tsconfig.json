{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@quotatain/shared": ["../../packages/shared/src/index.ts"],
      "@quotatain/database": ["../../packages/database/src/index.ts"],
      "@quotatain/queue": ["../../packages/queue/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "../../apps/web/**/*"]
}
