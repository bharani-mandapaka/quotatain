{
  "name": "@quotatain/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "@quotatain/database": "workspace:*",
    "@quotatain/queue": "workspace:*",
    "@quotatain/shared": "workspace:*",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.12.12",
    "cheerio": "^1.0.0",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.14.2",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^5.22.0",
    "tsup": "^8.5.1",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
